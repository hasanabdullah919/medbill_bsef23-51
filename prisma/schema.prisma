generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  storageKey        String   @unique
  size              Int
  mimeType          String   @default("application/pdf")
  status            String   @default("uploaded")
  task              String?
  result            String?
  provider          String?
  error             String?
  classification    String   @default("pending")
  destinationFolder String?
  validationReasons String[] @default([])
  processedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  claims            Claim[]

  @@index([classification, createdAt])
}

model DebugSession {
  id        String   @id @default(uuid()) @db.Uuid
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Patient {
  id          String      @id @default(uuid()) @db.Uuid
  firstName   String
  lastName    String
  dateOfBirth DateTime?   @db.Date
  gender      String?
  address     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  insurances  Insurance[]
  claims      Claim[]

  @@index([lastName, firstName])
}

model Insurance {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @db.Uuid
  providerName String
  memberId     String
  groupNumber  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  claims       Claim[]

  @@index([patientId])
  @@index([memberId])
}

model Claim {
  id                String     @id @default(uuid()) @db.Uuid
  claimNumber       String     @unique
  patientId         String     @db.Uuid
  insuranceId       String     @db.Uuid
  sourceDocumentId  String?    @db.Uuid
  source            String     @default("manual")
  status            String     @default("draft")
  providerName      String
  providerNpi       String?
  serviceDate       DateTime?  @db.Date
  diagnosisCode     String
  procedureCode     String
  placeOfService    String?
  chargeAmount      Decimal    @db.Decimal(12, 2)
  clinicalNote      String?
  validationReasons String[]   @default([])
  createdBy         String
  validatedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  patient           Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  insurance         Insurance  @relation(fields: [insuranceId], references: [id], onDelete: Restrict)
  sourceDocument    Document?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([patientId])
  @@index([sourceDocumentId])
}

# Supabase provides PostgreSQL only. No Supabase client, Auth, Storage or Data API.
DATABASE_URL=
DIRECT_URL=

# Cloudflare R2 (private bucket, object read/write credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=medbill-documents

# AI receives extracted text only. OCR runs inside Node.js with no AI API calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
ALLOW_LOCAL_FALLBACK=true

# Vercel request-body limit is below 15 MB; keep multipart uploads under 4 MB.
MAX_PDF_SIZE_MB=4
OCR_MAX_PAGES=50

# D1 demo access. Set a long random session secret in every deployed environment.
SESSION_SECRET=
DEMO_LOGIN_PASSWORD=D1Demo2026!
